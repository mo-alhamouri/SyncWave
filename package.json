{
  "name": "syncwave-desktop",
  "version": "1.2.8",
  "main": "electron/main.js",
  "scripts": {
    "setup": "npm install && npm run setup:frontend",
    "setup:frontend": "npm install --prefix frontend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev": "concurrently --kill-others \"npm run dev:frontend\" \"wait-on http://localhost:5173 && electron .\"",
    "start": "electron .",
    "build": "npm run build:frontend",
    "build:frontend": "npm install --prefix frontend && npm run build --prefix frontend",
    "dist": "npm run build:frontend && electron-builder --publish never",
    "deploy": "gh-pages -d \"Marketing Website\""
  },
  "build": {
    "appId": "com.syncwave.app",
    "productName": "SyncWave",
    "publish": [
      {
        "provider": "github",
        "owner": "mo-alhamouri",
        "repo": "SyncWave",
        "releaseType": "release"
      }
    ],
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "electron/**/*",
      "frontend/dist/**/*"
    ],
    "asarUnpack": [
      "**/node_modules/@ffmpeg-installer/**/*",
      "**/node_modules/@ffprobe-installer/**/*"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "win": {
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "target": [
        "nsis"
      ]
    },
    "afterPack": "scripts/adhoc-sign.js"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "gh-pages": "^6.3.0",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "electron-updater": "^6.1.7",
    "fix-path": "^3.0.0",
    "yt-dlp-wrap": "^2.3.12"
  },
  "description": "SyncWave - download, trim and manage your media.",
  "author": "Mo Alhamouri"
}
